# server/.env.example — ШАБЛОН (публикуется в репозитории)
# Реальные значения — в .env (он в .gitignore и не публикуется)

# Строка подключения к PostgreSQL:
# postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ
DATABASE_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@localhost:5432/ads_board

# Секретный ключ для подписи JWT. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=СГЕНЕРИРУЙТЕ_СЛУЧАЙНУЮ_СТРОКУ

# Порт backend-сервера
PORT=5000